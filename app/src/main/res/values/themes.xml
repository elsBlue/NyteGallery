<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SAOGallery" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/bg_night</item>
        <item name="android:navigationBarColor">@color/bg_night</item>
        <item name="android:windowBackground">@color/bg_night</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Launch theme: system splash (Android 12+) or the core-splashscreen copy on older versions.
         Shown only while the app starts; MainActivity swaps to Theme.SAOGallery via installSplashScreen(). -->
    <style name="Theme.SAOGallery.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/bg_night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.SAOGallery</item>
    </style>
</resources>
